TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ADMIN_IDS=123456789
POSTGRES_DB=reclaude
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me-use-a-long-random-value
DATABASE_URL=postgresql+asyncpg://bot:change-me-use-a-long-random-value@db:5432/reclaude
RECLAUDE_BASE_URL=https://www.reclaude.ai
RECLAUDE_ORG_ID=178
# Preferred server-side recovery login. Configure both values together.
RECLAUDE_LOGIN_EMAIL=
RECLAUDE_LOGIN_PASSWORD=
# Optional compatibility fallback or pre-seeded session. The cookie jar takes precedence when valid.
RECLAUDE_SESSION_COOKIE=
# The Compose file fixes the Cookie jar path on ./data/cookies, next to docker-compose.yml.
TIMEZONE=Asia/Shanghai
API_TIMEOUT_SECONDS=15
API_MAX_RETRIES=2
BASELINE_CAPTURE_WINDOW_SECONDS=60
MEMBER_SNAPSHOT_MAX_AGE_SECONDS=90
QUOTA_LIMIT_USD=700.00
LOG_LEVEL=INFO
